from pathlib import Path

import pandas as pd
import psycopg
import streamlit as st

from finance360.dashboard.data_access import load_dashboard_data
from finance360.dashboard.theme import apply_theme
from finance360.dashboard.visualizations import (
    contract_risk_chart,
    contract_volume_chart,
    credit_share_chart,
    exposure_chart,
    income_risk_chart,
    income_volume_chart,
    model_evidence_chart,
    observed_vs_predicted_chart,
    portfolio_outcome_chart,
    risk_distribution_chart,
)

PROJECT_ROOT = Path(__file__).resolve().parents[1]

st.set_page_config(
    page_title="Finance360 AI | Credit Risk Intelligence",
    page_icon="📊",
    layout="wide",
    initial_sidebar_state="expanded",
)

apply_theme()


@st.cache_data(ttl=300, show_spinner="Loading verified credit risk analytics...")
def get_data() -> dict:
    return load_dashboard_data(PROJECT_ROOT)


def evidence(source: str, population: str, explanation: str) -> None:
    with st.expander("Understand this chart | Evidence & explanation"):
        st.markdown(f"**What this means:** {explanation}")
        st.caption(f"Source: {source}")
        st.caption(f"Population: {population}")


st.sidebar.title("FINANCE360 AI")
st.sidebar.caption("Enterprise Credit Risk Intelligence")
st.sidebar.divider()
st.sidebar.info(
    "Use the sidebar to open the AI Credit Risk Predictor "
    "and estimate repayment difficulty for an applicant."
)
st.sidebar.caption("Historical dataset | No production scoring feed")

st.title("Credit Risk Intelligence Command Center")
st.caption(
    "Interactive portfolio intelligence backed by PostgreSQL warehouse "
    "analytics and validated machine-learning reports."
)

try:
    data = get_data()
except (OSError, ValueError, TypeError, KeyError, psycopg.Error) as error:
    st.error(f"Unable to load verified dashboard data: {error}")
    st.stop()

summary = data["portfolio_summary"].iloc[0]
contracts = data["contract_performance"]
income_groups = data["income_type_performance"]
risk_report = data["risk_segmentation"]
exposure_report = data["portfolio_exposure"]
evaluation = data["held_out_evaluation"]
monitoring = data["score_monitoring"]

total = int(summary["application_count"])
difficulty = int(summary["repayment_difficulty_count"])
difficulty_rate = float(summary["repayment_difficulty_rate_pct"])
total_credit = float(summary["total_requested_credit"])
average_credit = float(summary["average_requested_credit"])

if total != 307511 or difficulty != 24825:
    st.error("Portfolio totals do not match the validated source baseline.")
    st.stop()

if abs(difficulty_rate - difficulty / total * 100) > 0.01:
    st.error("Portfolio repayment-difficulty rate failed reconciliation.")
    st.stop()

if sum(segment["application_count"] for segment in risk_report["segments"]) != int(
    risk_report["training_rows"]
):
    st.error("Risk-segmentation counts failed reconciliation.")
    st.stop()

if sum(segment["application_count"] for segment in exposure_report["segments"]) != int(
    risk_report["training_rows"]
):
    st.error("Credit-exposure counts failed reconciliation.")
    st.stop()

st.success("Verified data loaded | Portfolio and risk-segment reconciliation passed")

kpi_1, kpi_2, kpi_3, kpi_4, kpi_5 = st.columns(5)

with kpi_1:
    st.metric("Applications", f"{total:,}")

with kpi_2:
    st.metric("Repayment difficulty", f"{difficulty:,}")

with kpi_3:
    st.metric("Observed difficulty rate", f"{difficulty_rate:.2f}%")

with kpi_4:
    st.metric("Requested credit", f"{total_credit / 1_000_000_000:.2f}B")

with kpi_5:
    st.metric("Average requested credit", f"{average_credit:,.0f}")

st.caption(
    "Portfolio KPIs cover all 307,511 historical applications. "
    "Credit amounts use unspecified source units and do not represent realized losses."
)

portfolio_tab, risk_tab, exposure_tab, model_tab = st.tabs(
    [
        "Portfolio Overview",
        "Risk Intelligence",
        "Credit Exposure",
        "Model Evidence",
    ]
)

with portfolio_tab:
    st.subheader("Portfolio Overview")

    left, right = st.columns(2)

    with left:
        st.plotly_chart(
            portfolio_outcome_chart(data["portfolio_summary"]),
            width="stretch",
        )
        evidence(
            "analytics.warehouse_portfolio_summary",
            f"{total:,} historical applications",
            (
                f"{difficulty:,} of {total:,} applications have a recorded "
                f"repayment-difficulty indicator ({difficulty_rate:.2f}%). "
                "The remaining applications do not have that indicator. "
                "This is a historical outcome, not a prediction."
            ),
        )

    with right:
        st.plotly_chart(
            contract_risk_chart(contracts),
            width="stretch",
        )
        evidence(
            "analytics.warehouse_contract_performance",
            f"{int(contracts['application_count'].sum()):,} applications",
            (
                "This compares observed repayment-difficulty rates for "
                "Cash loans and Revolving loans. Hover over a bar to see "
                "its sample size. Different group rates do not establish "
                "that the loan type caused repayment difficulty."
            ),
        )

    st.subheader("Application Volume by Loan Type")

    st.plotly_chart(
        contract_volume_chart(contracts),
        width="stretch",
    )

    evidence(
        "analytics.warehouse_contract_performance",
        f"{int(contracts['application_count'].sum()):,} applications",
        (
            "This chart shows how many applications belong to each loan type. "
            "A larger group has more applications, but that does not "
            "automatically mean it has a higher repayment-difficulty rate."
        ),
    )

    st.subheader("Income Source Analysis")

    available_groups = income_groups["income_type_name"].tolist()
    selected_groups = st.multiselect(
        "Choose income groups to compare",
        options=available_groups,
        default=available_groups,
    )

    selected_income = income_groups[
        income_groups["income_type_name"].isin(selected_groups)
    ]

    if selected_income.empty:
        st.info("Select at least one income group to display the comparison.")
    else:
        st.plotly_chart(
            income_risk_chart(selected_income),
            width="stretch",
        )

    small_groups = income_groups[income_groups["application_count"] < 100]

    if not small_groups.empty:
        st.warning(
            f"{len(small_groups)} income groups have fewer than 100 applications. "
            "Their observed rates can change substantially with very few cases."
        )

    evidence(
        "analytics.warehouse_income_type_performance",
        f"{int(income_groups['application_count'].sum()):,} applications",
        (
            "The chart compares repayment-difficulty rates across reported "
            "income-source categories. Higher bars indicate higher observed "
            "rates, not proof of causation. Always consider the sample size "
            "before drawing conclusions."
        ),
    )

    st.subheader("Income Group Application Volume")

    st.plotly_chart(
        income_volume_chart(income_groups),
        width="stretch",
    )

    evidence(
        "analytics.warehouse_income_type_performance",
        f"{int(income_groups['application_count'].sum()):,} applications",
        (
            "This chart shows which income-source categories have the "
            "largest application populations. Small categories may "
            "show unstable repayment-difficulty rates."
        ),
    )

    with st.expander("View underlying income-group evidence"):
        st.dataframe(
            income_groups[
                [
                    "income_type_name",
                    "application_count",
                    "repayment_difficulty_count",
                    "repayment_difficulty_rate_pct",
                ]
            ],
            width="stretch",
            hide_index=True,
        )

with risk_tab:
    st.subheader("Training Population Risk Intelligence")

    st.info(
        "These risk bands come from training-only out-of-fold model scores "
        "for 246,008 applications. They are not production monitoring results."
    )

    st.plotly_chart(
        risk_distribution_chart(risk_report),
        width="stretch",
    )

    evidence(
        "reports/monitoring/risk_segmentation.json",
        f"{risk_report['training_rows']:,} training applications",
        (
            "Applications are divided into Low, Moderate, High and Very High "
            "relative-risk groups using training-score quantiles. "
            "The bands describe the model's score distribution, not "
            "loan approval eligibility."
        ),
    )

    st.subheader("Observed vs Predicted Repayment Difficulty")

    st.plotly_chart(
        observed_vs_predicted_chart(risk_report),
        width="stretch",
    )

    evidence(
        "reports/monitoring/risk_segmentation.json",
        f"{risk_report['training_rows']:,} training applications",
        (
            "Each risk band compares the historical observed difficulty "
            "rate against the average model-predicted probability. "
            "Closer values suggest better group-level agreement. "
            "This is training out-of-fold evidence, not independent "
            "held-out calibration."
        ),
    )

    st.subheader("Observed Outcomes Within Each Risk Band")

    segment_rows = []

    for segment in risk_report["segments"]:
        segment_rows.append(
            {
                "Risk band": segment["risk_band"],
                "Applications": segment["application_count"],
                "Recorded difficulty": segment["positive_count"],
                "Observed difficulty rate (%)": round(
                    segment["observed_difficulty_rate"] * 100,
                    2,
                ),
                "Average model score (%)": round(
                    segment["mean_predicted_probability"] * 100,
                    2,
                ),
            }
        )

    st.dataframe(
        pd.DataFrame(segment_rows),
        width="stretch",
        hide_index=True,
    )

    boundaries = risk_report["boundaries"]

    st.caption(
        f"Training-derived risk boundaries: {boundaries[0]:.2%}, "
        f"{boundaries[1]:.2%}, {boundaries[2]:.2%}. "
        "These are relative score cutoffs, not regulatory thresholds."
    )

with exposure_tab:
    st.subheader("Requested Credit by Risk Segment")

    st.plotly_chart(
        exposure_chart(exposure_report),
        width="stretch",
    )

    evidence(
        "reports/monitoring/portfolio_exposure.json",
        f"{risk_report['training_rows']:,} training applications",
        (
            "This chart shows requested credit associated with each "
            "training-derived risk segment. Requested credit is a portfolio "
            "amount, not actual loss, recovery, or verified exposure at default."
        ),
    )

    st.subheader("Requested Credit Share by Risk Band")

    st.plotly_chart(
        credit_share_chart(exposure_report),
        width="stretch",
    )

    evidence(
        "reports/monitoring/portfolio_exposure.json",
        f"{risk_report['training_rows']:,} training applications",
        (
            "This donut shows each risk band's share of total requested "
            "credit within the training population. It does not show "
            "realized losses or expected credit loss."
        ),
    )

    exposure_rows = []

    for segment in exposure_report["segments"]:
        exposure_rows.append(
            {
                "Risk band": segment["risk_band"],
                "Applications": segment["application_count"],
                "Requested credit (billions)": round(
                    segment["total_requested_credit"] / 1_000_000_000,
                    2,
                ),
                "Share of requested credit (%)": round(
                    segment["requested_credit_share"] * 100,
                    2,
                ),
            }
        )

    st.dataframe(
        pd.DataFrame(exposure_rows),
        width="stretch",
        hide_index=True,
    )

    st.warning(
        "Requested credit must not be interpreted as expected credit loss. "
        "No verified loss-given-default or exposure-at-default estimates "
        "are available in this dataset."
    )

with model_tab:
    st.subheader("Held-Out XGBoost Model Evaluation")

    st.plotly_chart(
        model_evidence_chart(evaluation),
        width="stretch",
    )

    evidence(
        "reports/modeling/held_out_test_evaluation.json",
        "61,503 held-out test applications",
        (
            "ROC-AUC measures ranking ability, average precision summarizes "
            "precision-recall performance, and Brier score measures "
            "probability prediction error. Higher is better for ROC-AUC "
            "and average precision; lower is better for Brier score. "
            "These metrics measure different properties and should not "
            "be interpreted as interchangeable percentages."
        ),
    )

    metric_1, metric_2, metric_3 = st.columns(3)

    with metric_1:
        st.metric("ROC-AUC", f"{float(evaluation['roc_auc']):.4f}")

    with metric_2:
        st.metric(
            "Average precision",
            f"{float(evaluation['average_precision']):.4f}",
        )

    with metric_3:
        st.metric("Brier score", f"{float(evaluation['brier_score']):.4f}")

    st.subheader("Score Distribution Monitoring")

    psi = float(monitoring["psi_result"]["psi"])

    st.metric("Random-half score PSI", f"{psi:.6f}")

    st.info(
        "This PSI compares two random halves of historical training data. "
        "It is a pipeline stability demonstration, not evidence of "
        "temporal or production model drift."
    )

st.divider()
st.caption(
    "Finance360 AI | Historical Home Credit data | "
    "Educational portfolio analytics and model decision support only. "
    "No automated lending decisions."
)